{
  "name": "listing-api",
  "version": "1.0.0",
  "description": "",
  "main": "bootstrap.js",
  "scripts": {
    "build": "tsc && npm run sentry:sourcemaps",
    "start": "NODE_ENV=production node bootstrap.js",
    "dev": "NODE_ENV=development nodemon -r tsconfig-paths/register --exec ts-node server/server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org ziti --project ziti-api-listings ./dist && sentry-cli sourcemaps upload --org ziti --project ziti-api-listings ./dist"
  },
  "keywords": [],
  "author": "Ziti, Inc.",
  "license": "ISC",
  "_moduleAliases": {
    "@api": "dist/api",
    "@config": "dist/config",
    "@middleware": "dist/middleware",
    "@types": "dist/types",
    "@utils": "dist/utils"
  },
  "dependencies": {
    "@sentry/cli": "^2.31.0",
    "@sentry/node": "^7.110.1",
    "@sentry/profiling-node": "^7.110.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "2.2.3",
    "pg": "^8.11.5",
    "redis": "^4.6.13",
    "sequelize": "^6.37.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.56.0",
    "eslint-config-love": "^47.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.0.0",
    "eslint-plugin-promise": "^6.1.1",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.4.5"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
